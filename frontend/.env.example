# Browser + BFF both read this. The BFF proxies to the backend with Bearer tokens.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Optional override used only by server-side BFF routes (defaults to NEXT_PUBLIC_API_URL).
# API_URL=http://localhost:8000/api/v1

# Cookie signing secret for local session cookies (change in production).
SESSION_SECRET=dev-only-change-me
