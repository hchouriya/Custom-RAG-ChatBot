# Aegis RAG Platform — configuration
#
# Copy to `.env` and fill the marked secrets. The process refuses to start on a
# missing or invalid required value rather than failing on the first user request.
# Values here are boot defaults; rows in the `settings` table override the
# retrieval tunables at runtime (see docs/architecture/09 §2).

# ─────────────────────────────────────────────────────────────────────────────
# Core
# ─────────────────────────────────────────────────────────────────────────────
APP_ENV=development                       # development | staging | production
APP_NAME=Aegis Assistant
LOG_LEVEL=INFO
LOG_FORMAT=console                        # console (dev) | json (staging, production)
# REQUIRED. Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-min-32-chars-long-secret-value-here
CORS_ORIGINS=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:8000

# ─────────────────────────────────────────────────────────────────────────────
# PostgreSQL
# ─────────────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://aegis:aegis@localhost:55432/aegis
# Host port 55432 → container 5432 (avoids local Windows Postgres on 5432/5433).
# Inside Docker Compose services, use postgres:5432 instead.
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=10
DATABASE_ECHO=false

# ─────────────────────────────────────────────────────────────────────────────
# Redis (cache, rate limiting, idempotency, arq queue)
# ─────────────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
REDIS_QUEUE_DB=1                          # arq gets its own db so a cache flush cannot eat jobs
REDIS_MAX_CONNECTIONS=50
CACHE_NAMESPACE=aegis                     # keys are prefixed with `<namespace>:<app_env>:`

# ─────────────────────────────────────────────────────────────────────────────
# Vector store
# ─────────────────────────────────────────────────────────────────────────────
VECTOR_BACKEND=qdrant                     # qdrant | pgvector | memory
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_PREFER_GRPC=false
QDRANT_QUANTIZATION=true                  # int8 + rescoring; see docs/architecture/01 §1
QDRANT_ON_DISK_PAYLOAD=true

# ─────────────────────────────────────────────────────────────────────────────
# Object storage (MinIO locally, S3 in cloud — one adapter for both)
# ─────────────────────────────────────────────────────────────────────────────
STORAGE_BACKEND=s3                        # s3 | local; local is refused in production
LOCAL_STORAGE_PATH=./var/objects          # only used by STORAGE_BACKEND=local
S3_ENDPOINT_URL=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=aegis-documents
S3_ACCESS_KEY_ID=aegis
S3_SECRET_ACCESS_KEY=aegis-dev-secret
S3_PRESIGN_TTL_SECONDS=900
S3_FORCE_PATH_STYLE=true                  # required by MinIO

# ─────────────────────────────────────────────────────────────────────────────
# Embeddings — local-first: BGE-M3 on a TEI sidecar, nothing leaves the network
# ─────────────────────────────────────────────────────────────────────────────
EMBEDDING_PROVIDER=bge_tei                # bge_tei | openai | voyage | cohere | fake
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024                        # bge-m3=1024, text-embedding-3-large=3072
EMBEDDING_BATCH_SIZE=64
EMBEDDING_MAX_CONCURRENCY=4
EMBEDDING_CACHE_TTL_SECONDS=604800
TEI_EMBED_URL=http://tei-embed:8080

# Reranking (adapters land in Phase 3; configured here so one file holds the surface)
RERANKER_PROVIDER=bge_tei                 # bge_tei | cross_encoder | cohere | noop
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
TEI_RERANK_URL=http://tei-rerank:8081

# ─────────────────────────────────────────────────────────────────────────────
# LLM — one hosted provider, with a fallback chain
# ─────────────────────────────────────────────────────────────────────────────
LLM_PROVIDER=openai                       # openai | anthropic | gemini
LLM_MODEL=gpt-5.1
LLM_FALLBACK_CHAIN=anthropic:claude-sonnet-4.5
LLM_TEMPERATURE=0.1
LLM_MAX_OUTPUT_TOKENS=2000
LLM_TIMEOUT_SECONDS=90
INTENT_MODEL=gpt-5-mini

# Provider keys — leave blank for any provider you do not use.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
VOYAGE_API_KEY=
COHERE_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Retrieval (Phase 3 consumers; overridable at runtime via /settings)
# ─────────────────────────────────────────────────────────────────────────────
RETRIEVAL_TOP_K_DENSE=40
RETRIEVAL_TOP_K_SPARSE=40
RETRIEVAL_RRF_K=60
RERANK_TOP_N=8
CONFIDENCE_MIN_TOP_SCORE=0.35
CONFIDENCE_MIN_SUPPORTING=2
CONFIDENCE_MIN_MEAN_TOP3=0.28
CONFIDENCE_MIN_ENTITY_COVERAGE=0.5
CONTEXT_TOKEN_BUDGET=10000
PROMPT_TOKEN_CAP=16000
HISTORY_TOKEN_BUDGET=2000
SUMMARY_TOKEN_BUDGET=600

# ─────────────────────────────────────────────────────────────────────────────
# Ingestion
# ─────────────────────────────────────────────────────────────────────────────
MAX_UPLOAD_BYTES=209715200                # 200 MB
CHUNK_SIZE=800
CHUNK_OVERLAP_PCT=15
CHUNK_MIN_TOKENS=250
CHUNK_MAX_TOKENS=1400
CHUNK_STRATEGY=adaptive                   # adaptive | recursive | semantic | markdown
CONTEXTUAL_HEADERS=true
OCR_ENABLED=true
OCR_DPI=300
OCR_LANGUAGES=eng
OCR_MIN_CHARS_PER_PAGE=100                # below this, a PDF page is treated as scanned
MALWARE_SCAN_ENABLED=false                # true in staging and production
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
INGEST_MAX_ATTEMPTS=3
DEFAULT_LANGUAGE=en

# ─────────────────────────────────────────────────────────────────────────────
# Authentication
# ─────────────────────────────────────────────────────────────────────────────
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14
JWT_ALGORITHM=HS256                       # HS256 | RS256 (RS256 needs the key pair below)
JWT_PRIVATE_KEY_PATH=
JWT_PUBLIC_KEY_PATH=
PASSWORD_MIN_LENGTH=12
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
MFA_ENABLED=true
MFA_REQUIRED_ROLES=admin,manager          # TOTP enrolment enforced for these roles
MFA_ISSUER=Aegis
GUEST_ACCESS_ENABLED=true
SECRETS_PROVIDER=env                      # env | aws | vault

# ─────────────────────────────────────────────────────────────────────────────
# Rate limits (requests per window, per principal and per IP)
# ─────────────────────────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_PER_15MIN=10
RATE_LIMIT_CHAT_PER_MIN_GUEST=5
RATE_LIMIT_CHAT_PER_MIN_CUSTOMER=20
RATE_LIMIT_CHAT_PER_MIN_INTERNAL=60
RATE_LIMIT_CHAT_PER_MIN_ADMIN=120
RATE_LIMIT_UPLOAD_PER_HOUR=60
RATE_LIMIT_TICKET_PER_HOUR=3
MAX_CONCURRENT_STREAMS_PER_USER=3

# ─────────────────────────────────────────────────────────────────────────────
# Observability
# ─────────────────────────────────────────────────────────────────────────────
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAME=aegis-api
TRACE_SAMPLE_RATIO=0.1
METRICS_ENABLED=true
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Frontend (consumed by the Next.js BFF, not by the API)
# ─────────────────────────────────────────────────────────────────────────────
API_INTERNAL_URL=http://api:8000
NEXT_PUBLIC_APP_NAME=Aegis Assistant
# REQUIRED for cookie encryption in the BFF; 32+ bytes.
SESSION_SECRET=change-me-another-32-char-minimum-secret
